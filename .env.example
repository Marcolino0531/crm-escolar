# Supabase (projeto Schooler Hub)
# Client (Vite, build-time) — chave anon/publishable
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Server (SSR / server functions)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Sponte (server-side only) — credenciais por unidade
# CEC e CEC Baby compartilham o mesmo token (segmentado por TurmaAtual).
SPONTE_CODIGO_CLIENTE="your-sponte-client-code"
SPONTE_TOKEN="your-sponte-token"
# Núcleo Belvedere — credenciais EXCLUSIVAS (sem divisão de turmas).
SPONTE_BELVEDERE_CODIGO_CLIENTE="your-belvedere-client-code"
SPONTE_BELVEDERE_TOKEN="your-belvedere-token"
